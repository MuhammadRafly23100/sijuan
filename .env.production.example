# Kredensial versi online (Vercel + Supabase).
#
# 1. Salin file ini menjadi .env.production (tidak ikut git) dan isi yang kosong.
# 2. Buat APP_KEY:          php artisan key:generate --env=production --force
# 3. Buat tabel + akun demo: php artisan migrate --env=production --force --seed
# 4. Masukkan nilai yang sama ke Vercel: Settings -> Environment Variables.

APP_KEY=

# Supabase -> Connect -> Session pooler (port 5432). Ganti [YOUR-PASSWORD].
DB_CONNECTION=pgsql
DB_URL=

# Supabase -> Storage: buat bucket privat "nota", lalu buat S3 access key.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=nota
AWS_ENDPOINT=https://PROJECT-REF.storage.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true
